#!/usr/bin/env bash
# Run an engine script with the project's Python environment, creating the
# environment on first use. Usage, from the repo root:
#   .agents/skills/_shared/scripts/py .agents/skills/_shared/scripts/sync.py --status
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
VENV="$REPO_ROOT/.venv"
PYTHON="$VENV/bin/python"

if [ ! -x "$PYTHON" ]; then
  echo "creating project Python environment in .venv ..." >&2
  python3 -m venv "$VENV"
  "$PYTHON" -m pip install --quiet --upgrade pip
  "$PYTHON" -m pip install --quiet -r "$SCRIPT_DIR/../requirements.txt"
fi

exec "$PYTHON" "$@"
