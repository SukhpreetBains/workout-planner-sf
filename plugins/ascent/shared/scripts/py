#!/usr/bin/env bash
# Run a workspace engine script with the Opportunity's Python environment,
# creating the environment on first use. Set EAD_REPO_ROOT to the Opportunity
# folder when the installed skill library lives elsewhere.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${EAD_REPO_ROOT:-$PWD}"
VENV="$REPO_ROOT/workspace/.system/.venv"
PYTHON="$VENV/bin/python"

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
  echo "Python 3.10 or newer is required." >&2
  exit 1
fi

if [ ! -x "$PYTHON" ]; then
  echo "creating workspace Python environment in workspace/.system/.venv ..." >&2
  python3 -m venv "$VENV"
  "$PYTHON" -m pip install --quiet --upgrade pip
  "$PYTHON" -m pip install --quiet -r "$SCRIPT_DIR/../requirements.txt"
fi

exec "$PYTHON" "$@"
