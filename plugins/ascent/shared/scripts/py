#!/usr/bin/env bash
# Run a workspace engine script with a per-user Python environment outside the
# synced Project folder. Set ASCENT_PROJECT_ROOT when the Project
# is not the current directory. Set ASCENT_PYTHON to pin the base interpreter.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="${ASCENT_PROJECT_ROOT:-$PWD}"
INSTALL_DEPENDENCIES=0

if [ "${1:-}" = "--install-dependencies" ]; then
  INSTALL_DEPENDENCIES=1
  shift
fi

if [ -n "${ASCENT_PYTHON:-}" ]; then
  BASE_PYTHON="$ASCENT_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
  BASE_PYTHON="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  BASE_PYTHON="$(command -v python)"
else
  echo "Python 3.10 or newer is required." >&2
  exit 1
fi

if ! "$BASE_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
  echo "Python 3.10 or newer is required. ASCENT_PYTHON resolved to: $BASE_PYTHON" >&2
  exit 1
fi

PROJECT_ROOT="$($BASE_PYTHON -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).expanduser().resolve())' "$PROJECT_ROOT")"
export ASCENT_PROJECT_ROOT="$PROJECT_ROOT"
"$BASE_PYTHON" "$SCRIPT_DIR/launcher_preflight.py" "$@"
PATH_HASH="$($BASE_PYTHON -c 'import hashlib, os, sys; value=os.path.normcase(os.path.realpath(sys.argv[1])).encode("utf-8"); print(hashlib.sha256(value).hexdigest()[:20])' "$PROJECT_ROOT")"
CACHE_ROOT="${ASCENT_CACHE_DIR:-$HOME/.ascent}"
VENV="$CACHE_ROOT/venvs/$PATH_HASH"
PYTHON="$VENV/bin/python"
POINTER="$PROJECT_ROOT/workspace/.system/.venv-path"

if [ ! -x "$PYTHON" ]; then
  echo "creating cached Python environment: $VENV" >&2
  "$BASE_PYTHON" -m venv "$VENV"
fi

mkdir -p "$(dirname "$POINTER")"
printf '%s\n' "$VENV" > "$POINTER"

if [ "$INSTALL_DEPENDENCIES" -eq 1 ]; then
  echo "installing Ascent Python dependencies into: $VENV" >&2
  "$PYTHON" -m pip install -r "$SCRIPT_DIR/../requirements.txt"
elif ! "$PYTHON" -c 'import docx, fitz, openpyxl, pptx, yaml' >/dev/null 2>&1; then
  echo "Ascent Python dependencies are not installed in $VENV." >&2
  echo "After getting approval to install them, rerun this command with --install-dependencies before the script and its arguments." >&2
  exit 2
fi

exec "$PYTHON" "$@"
