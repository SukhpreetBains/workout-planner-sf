    "ways-of-working.team-norms": {
      "status": "answered",
      "answer": [
        {
          "title": "Protect collaboration time",
          "summary": "Agree overlapping hours across the team.",
          "detail": "Use the shared calendar to identify collaboration windows. Surface availability changes early."
        },
        {
          "title": "Keep decisions visible",
          "summary": "Maintain one shared record of work and decisions.",
          "detail": "Record acceptance criteria, decisions, test evidence, and delivery progress in the agreed tracking system."
        },
        {
          "title": "Raise blockers early",
          "summary": "Make dependencies and support needs explicit.",
          "detail": "Name an owner and the needed decision when raising a blocker; use the agreed escalation path when timing threatens delivery."
        }
      ],
      "answered_by": "source",
      "disposition": "rendered",
