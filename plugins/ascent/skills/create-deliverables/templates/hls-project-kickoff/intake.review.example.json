    "ways-of-working.meeting-details": {
      "status": "answered",
      "answer": [
        {
          "title": "Backlog refinement",
          "frequency": "Twice weekly, 60 minutes",
          "owner": "Solution architect",
          "summary": "Prepare future stories and clarify dependencies.",
          "participants": [
            "Product owner",
            "Delivery team",
            "Business SMEs"
          ],
          "detail": "Review requirements, acceptance criteria, estimates, and open questions before sprint planning."
        },
        {
          "title": "Sprint planning",
          "frequency": "Every three weeks, 90 minutes",
          "owner": "Program manager",
          "summary": "Agree a realistic sprint commitment.",
          "participants": [
            "Product owner",
            "Delivery team"
          ],
          "detail": "Confirm goals, capacity, dependencies, and scope before work begins."
        },
        {
          "title": "Daily standup",
          "frequency": "Daily, 15 minutes",
          "owner": "Program manager",
          "summary": "Surface progress, blockers, and collaboration needs.",
          "participants": [
            "Delivery team",
            "Client core team"
          ],
          "detail": "Keep updates concise and move detailed problem solving into focused follow-up sessions."
        },
        {
          "title": "Sprint demonstration",
          "frequency": "Every three weeks, 60 minutes",
          "owner": "Solution architect",
          "summary": "Review working functionality and capture feedback.",
          "participants": [
            "Product owner",
            "Delivery team",
            "Change champions"
          ],
          "detail": "Demonstrate completed scenarios; record decisions and refinement needs in the backlog."
        },
        {
          "title": "Retrospective",
          "frequency": "Every three weeks, 30 minutes",
          "owner": "Program manager",
          "summary": "Improve how the team delivers.",
          "participants": [
            "Delivery team"
          ],
          "detail": "Agree a small set of owned improvements and review their effect next sprint."
        },
        {
          "title": "Program status",
          "frequency": "Weekly, 45 minutes",
          "owner": "Program manager",
          "summary": "Review milestones, risks, and decisions.",
          "participants": [
            "Client program team",
            "Workstream leads"
          ],
          "detail": "Maintain shared visibility of schedule changes, blockers, and needed decisions."
        },
        {
          "title": "Steering committee",
          "frequency": "Monthly, 60 minutes",
          "owner": "Engagement lead",
          "summary": "Resolve strategic trade-offs and escalations.",
          "participants": [
            "Executive sponsors",
            "Program leadership"
          ],
          "detail": "Review delivery health and decisions requiring executive direction."
        },
        {
          "title": "Change and adoption sync",
          "frequency": "Every other week, 45 minutes",
          "owner": "Change and adoption lead",
          "summary": "Coordinate readiness, communication, and training.",
          "participants": [
            "Change champions",
            "Program manager"
          ],
          "detail": "Review user feedback and planned enablement activities alongside delivery progress."
        }
      ],
      "answered_by": "source",
      "disposition": "rendered",
      "sources": [
