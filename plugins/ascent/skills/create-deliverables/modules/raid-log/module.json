{
  "schema_version": 1,
  "id": "raid-log",
  "title": "RAID Log",
  "description": "A central, maintained register for assumptions, risks, issues, dependencies, actions, and decisions that require active management.",
  "questions": [
    {
      "id": "raid-log.items",
      "tier": "required",
      "prompt": "Which items need tracking now, and who owns each?",
      "answer_type": "risks",
      "source_ref": "Ascent Modules.xlsx/List of Modules/RAID log/clarification-1"
    },
    {
      "id": "raid-log.thresholds",
      "tier": "required",
      "prompt": "What severity thresholds trigger escalation?",
      "answer_type": "decision",
      "source_ref": "Ascent Modules.xlsx/List of Modules/RAID log/clarification-2"
    },
    {
      "id": "raid-log.closure",
      "tier": "optional",
      "prompt": "How will the log be reviewed and items closed?",
      "answer_type": "text",
      "source_ref": "Ascent Modules.xlsx/List of Modules/RAID log/clarification-3"
    }
  ],
  "default_output": [
    {
      "id": "raid-log",
      "type": "table",
      "renderer": "./html.mjs#raid-log",
      "uses": [
        "raid-log.items",
        "raid-log.thresholds",
        "raid-log.closure"
      ]
    }
  ]
}
