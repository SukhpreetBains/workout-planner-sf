{
  "schema_version": 1,
  "id": "engagement-financials",
  "title": "Engagement Financials",
  "description": "Contract spend, invoicing, and team effort against the SOW. Confirm with the account executive or resource leader which of these views apply to a given engagement — financial review is often scheduled separately.",
  "questions": [
    {
      "id": "engagement-financials.contract-summary",
      "tier": "required",
      "prompt": "What is the contract limit, current spend (pre-tax), and remaining balance to contract?",
      "answer_type": "list",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 11"
    },
    {
      "id": "engagement-financials.invoices",
      "tier": "optional",
      "prompt": "What invoices have been issued, and what is each one's amount and status?",
      "answer_type": "table",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 11"
    },
    {
      "id": "engagement-financials.team-effort",
      "tier": "required",
      "prompt": "For each engagement team role, what is the SOW total hours and actuals to date?",
      "answer_type": "table",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 11"
    },
    {
      "id": "engagement-financials.notes",
      "tier": "optional",
      "prompt": "Any notes on financial status the client should see?",
      "answer_type": "text",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 11"
    }
  ],
  "default_output": [
    {
      "id": "contract-summary",
      "type": "kpi-row",
      "renderer": "./html.mjs#contract-summary",
      "uses": ["engagement-financials.contract-summary"]
    },
    {
      "id": "invoices",
      "type": "table",
      "renderer": "./html.mjs#invoices",
      "uses": ["engagement-financials.invoices"]
    },
    {
      "id": "team-effort",
      "type": "table",
      "renderer": "./html.mjs#team-effort",
      "uses": ["engagement-financials.team-effort"]
    },
    {
      "id": "notes",
      "type": "purpose",
      "renderer": "./html.mjs#notes",
      "uses": ["engagement-financials.notes"]
    }
  ]
}
