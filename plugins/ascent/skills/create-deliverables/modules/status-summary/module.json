{
  "schema_version": 1,
  "id": "status-summary",
  "title": "Status Summary",
  "description": "The weekly health readout: sponsor and PM roster, a per-area RAG scorecard, scope status, this week's and next week's activity, critical open questions, and key milestones.",
  "questions": [
    {
      "id": "status-summary.roster",
      "tier": "required",
      "prompt": "Who are the sponsor, client PM, and Slalom PM for this engagement?",
      "answer_type": "people",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 6"
    },
    {
      "id": "status-summary.scorecard",
      "tier": "required",
      "prompt": "What is the current RAG status for schedule, scope, budget, resources, and issues/risks, and the overall roll-up?",
      "answer_type": "table",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 3"
    },
    {
      "id": "status-summary.scope-note",
      "tier": "required",
      "prompt": "What's the high-level scope and status narrative, especially the reasons behind any Amber or Red area?",
      "answer_type": "text",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 6"
    },
    {
      "id": "status-summary.completed",
      "tier": "required",
      "prompt": "What key activities were completed this week?",
      "answer_type": "list",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 6"
    },
    {
      "id": "status-summary.planned",
      "tier": "required",
      "prompt": "What key activities are planned for next week?",
      "answer_type": "list",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 6"
    },
    {
      "id": "status-summary.critical-questions",
      "tier": "optional",
      "prompt": "What critical open questions or issues need discussion?",
      "answer_type": "list",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 6"
    },
    {
      "id": "status-summary.milestones",
      "tier": "optional",
      "prompt": "What are the key milestones relevant to this reporting period, their dates, and current status?",
      "answer_type": "milestones",
      "source_ref": "Slalom Weekly Status Report - Template.pdf/Slide 6"
    }
  ],
  "default_output": [
    {
      "id": "roster",
      "type": "table",
      "renderer": "./html.mjs#roster",
      "uses": ["status-summary.roster"]
    },
    {
      "id": "scorecard",
      "type": "status-grid",
      "renderer": "./html.mjs#scorecard",
      "uses": ["status-summary.scorecard"]
    },
    {
      "id": "scope-note",
      "type": "purpose",
      "renderer": "./html.mjs#scope-note",
      "uses": ["status-summary.scope-note"]
    },
    {
      "id": "completed",
      "type": "next-steps",
      "renderer": "./html.mjs#completed",
      "uses": ["status-summary.completed"]
    },
    {
      "id": "planned",
      "type": "next-steps",
      "renderer": "./html.mjs#planned",
      "uses": ["status-summary.planned"]
    },
    {
      "id": "critical-questions",
      "type": "next-steps",
      "renderer": "./html.mjs#critical-questions",
      "uses": ["status-summary.critical-questions"]
    },
    {
      "id": "milestones",
      "type": "table",
      "renderer": "./html.mjs#milestones",
      "uses": ["status-summary.milestones"]
    }
  ]
}
