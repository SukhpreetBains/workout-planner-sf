{
  "schema_version": 1,
  "id": "decision-log",
  "title": "Decision Log",
  "description": "A traceable record of decisions, approvals, alternatives, and their delivery implications.",
  "questions": [
    {
      "id": "decision-log.decisions",
      "tier": "required",
      "prompt": "What decision is pending or confirmed, and who has authority?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Decision log/clarification-1"
    },
    {
      "id": "decision-log.rationale",
      "tier": "required",
      "prompt": "What alternatives and rationale should be recorded?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Decision log/clarification-2"
    },
    {
      "id": "decision-log.impact",
      "tier": "optional",
      "prompt": "What delivery impacts and follow-up actions result from the decision?",
      "answer_type": "owned-actions",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Decision log/clarification-3"
    }
  ],
  "default_output": [
    {
      "id": "decisions",
      "type": "table",
      "renderer": "./html.mjs#decisions",
      "uses": [
        "decision-log.decisions",
        "decision-log.rationale",
        "decision-log.impact"
      ]
    }
  ]
}
