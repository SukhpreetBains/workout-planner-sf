{
  "schema_version": 1,
  "id": "stakeholder-register",
  "title": "Stakeholder Register",
  "description": "An actionable inventory of stakeholders, their roles, influence, engagement needs, and communication preferences.",
  "questions": [
    {
      "id": "stakeholder-register.stakeholders",
      "tier": "required",
      "prompt": "Who can influence decisions, enable delivery, or be affected by the project?",
      "answer_type": "people",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Stakeholder register/clarification-1"
    },
    {
      "id": "stakeholder-register.engagement",
      "tier": "required",
      "prompt": "What involvement and communication does each stakeholder need?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Stakeholder register/clarification-2"
    },
    {
      "id": "stakeholder-register.owners",
      "tier": "optional",
      "prompt": "Who owns each stakeholder relationship?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Stakeholder register/clarification-3"
    }
  ],
  "default_output": [
    {
      "id": "stakeholders",
      "type": "table",
      "renderer": "./html.mjs#stakeholders",
      "uses": [
        "stakeholder-register.stakeholders",
        "stakeholder-register.engagement",
        "stakeholder-register.owners"
      ]
    }
  ]
}
