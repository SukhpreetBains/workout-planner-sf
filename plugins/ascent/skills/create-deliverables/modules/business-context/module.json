{
  "schema_version": 1,
  "id": "business-context",
  "title": "Business context / why the project exists",
  "description": "Connects the engagement to the current-state challenge, business drivers, and value at stake.",
  "questions": [
    {
      "id": "business-context.problem",
      "tier": "required",
      "prompt": "What business problem prompted this project, and why now?",
      "answer_type": "text",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Business context/clarification-1"
    },
    {
      "id": "business-context.impact",
      "tier": "required",
      "prompt": "Which customer or business impacts matter most?",
      "answer_type": "list",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Business context/clarification-2"
    },
    {
      "id": "business-context.language",
      "tier": "optional",
      "prompt": "How should the challenge be described to leadership?",
      "answer_type": "text",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Business context/clarification-3"
    }
  ],
  "default_output": [
    {
      "id": "context",
      "type": "theme-group",
      "renderer": "./html.mjs#context",
      "uses": [
        "business-context.problem",
        "business-context.impact",
        "business-context.language"
      ]
    }
  ]
}
