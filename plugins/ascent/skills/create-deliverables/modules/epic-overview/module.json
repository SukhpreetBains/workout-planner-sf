{
  "schema_version": 1,
  "id": "epic-overview",
  "title": "Epic Overview",
  "description": "Major capability groups linked to outcomes, MVP priorities, owners, and acceptance expectations.",
  "questions": [
    {
      "id": "epic-overview.epics",
      "tier": "required",
      "prompt": "Which epics are confirmed, and what outcome does each support?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Epic overview/clarification-1"
    },
    {
      "id": "epic-overview.releases",
      "tier": "required",
      "prompt": "Which epics belong in the first release versus later releases?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Epic overview/clarification-2"
    },
    {
      "id": "epic-overview.ownership",
      "tier": "optional",
      "prompt": "Who owns each epic and confirms priority and acceptance?",
      "answer_type": "table",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Epic overview/clarification-3"
    }
  ],
  "default_output": [
    {
      "id": "epics",
      "type": "table",
      "renderer": "./html.mjs#epics",
      "uses": [
        "epic-overview.epics",
        "epic-overview.releases",
        "epic-overview.ownership"
      ]
    }
  ]
}
