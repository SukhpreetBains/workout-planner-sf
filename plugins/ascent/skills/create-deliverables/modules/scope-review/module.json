{
  "schema_version": 1,
  "id": "scope-review",
  "title": "Scope review",
  "description": "Establishes what the engagement will and will not cover so the team shares practical boundaries.",
  "questions": [
    {
      "id": "scope-review.included",
      "tier": "required",
      "prompt": "Which capabilities and workstreams are in scope for this phase?",
      "answer_type": "list",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Scope review/clarification-1"
    },
    {
      "id": "scope-review.excluded",
      "tier": "required",
      "prompt": "What is explicitly excluded or deferred?",
      "answer_type": "list",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Scope review/clarification-2"
    },
    {
      "id": "scope-review.controls",
      "tier": "optional",
      "prompt": "Which assumptions or change-control rules govern the boundaries?",
      "answer_type": "text",
      "source_ref": "Ascent Modules.xlsx/List of Modules/Scope review/clarification-3"
    }
  ],
  "default_output": [
    {
      "id": "scope",
      "type": "table",
      "renderer": "./html.mjs#scope",
      "uses": [
        "scope-review.included",
        "scope-review.excluded",
        "scope-review.controls"
      ]
    }
  ]
}
